# ============================================================
#  AI Email Marketing Campaign Builder — Credentials File
#  This is a DUMMY credentials file for local development.
#  All values are placeholders — the app runs fully offline.
# ============================================================

# --- App ---
APP_NAME="AI Email Campaign Builder"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# --- Backend API (Express) ---
BACKEND_PORT=4000
BACKEND_URL="http://localhost:4000"

# --- Frontend (Next.js) ---
FRONTEND_PORT=3100

# --- Database (NOT USED — app uses in-memory store) ---
DATABASE_URL="postgresql://campaign_user:campaign_pass@localhost:5434/email_campaigns"

# --- AI / Anthropic (NOT USED — app uses mock AI generator) ---
ANTHROPIC_API_KEY="sk-ant-dummy-key-for-local-development-only"

# --- Email / SMTP (NOT USED — app logs emails to console) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER="dummy_user"
SMTP_PASS="dummy_password"
SMTP_FROM="campaigns@localhost"

# --- Auth (placeholder) ---
JWT_SECRET="super-secret-jwt-key-change-in-production"
SESSION_SECRET="session-secret-change-in-production"

# --- Feature Flags ---
ENABLE_AB_TESTING="true"
ENABLE_ANALYTICS="true"
MAX_VARIANTS=3
